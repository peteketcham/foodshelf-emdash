---
import { getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site";
import { localeOf, strings, otherLocale, homePath, type Lang } from "../i18n";
import type { Alternate } from "../utils/translations";

interface Props {
	title: string;
	description?: string | null;
	/** Translations of this page (for the language switch). */
	alternates?: Alternate[];
	isHome?: boolean;
	/** Pass the content reference so EmDash can attach edit tooling to the page. */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, description, alternates = [], isHome = false, content } = Astro.props;
const lang: Lang = localeOf(Astro);
const t = strings(lang);
const switchTo = alternates.find((a) => a.locale === otherLocale(lang))?.href ?? homePath(otherLocale(lang));
const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);
const siteTitle = settingsResult.data?.title || site.name;
const fullTitle = isHome ? siteTitle : `${title} | ${siteTitle}`;
const pageDescription = description || settingsResult.data?.tagline || site.name;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title,
	description: pageDescription,
	canonical: null,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="keywords" content={site.keywords} />
		<link rel="icon" href="/favicon.ico" />

		<link rel="stylesheet" href="/layout/style.css" />
		<link rel="stylesheet" href="/layout/plugins/cssanimation/animate.css" />
		<link rel="stylesheet" href="/layout/plugins/cssanimation/delays.css" />
		<link rel="stylesheet" href="/css/custom.css" />
		<link rel="stylesheet" href="/css/foodshelf.css" />
		<EmDashHead page={pageCtx} />
	</head>

	<body class="sticky_footer">
		<EmDashBodyStart page={pageCtx} />
		<a href="#content" class="skip-link">{t.skip}</a>

		<div class="wrapper">
			<Header switchTo={switchTo} />

			<main id="content" role="main">
				<slot />
			</main>

			<Footer />
		</div>

		<script is:inline>
			var isMobile = false;
			var isiPad = false;
			(function () {
				var mobileIds = ["iphone", "android", "ipad", "ipod"];
				var ua = navigator.userAgent.toLowerCase();
				for (var i = 0; i < mobileIds.length; i++) {
					if (ua.indexOf(mobileIds[i]) > -1) {
						isMobile = true;
						if (mobileIds[i] === "ipad") isiPad = true;
					}
				}
			})();
		</script>
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
		<script is:inline src="/layout/js/main.js"></script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
