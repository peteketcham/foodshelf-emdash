---
import { site } from "../site";
import { localeOf } from "../i18n";
const es = localeOf(Astro) === "es";
const L = es
	? { intro: "Complete el formulario a continuación y haga clic en el botón \u201cEnviar mensaje\u201d. ¡Gracias!", name: "Nombre", email: "Correo electrónico", subject: "Asunto", message: "Mensaje", send: "Enviar mensaje" }
	: { intro: "Fill out the form below and click the \u201cSend Message\u201d button. Thank you!", name: "Name", email: "E-mail", subject: "Subject", message: "Message", send: "Send Message" };
---
<div class="contact-form-section">
	<p>{L.intro}</p>
	<form action={`https://formspree.io/f/${site.formspreeId}`} method="POST" class="contact-form" id="contact_form">
		<input type="hidden" name="_subject" value="Information request from the food shelf website" />
		<input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
		<div class="form-group"><label for="name">{L.name} <span class="required">*</span></label><input type="text" id="name" name="name" required /></div>
		<div class="form-group"><label for="email">{L.email} <span class="required">*</span></label><input type="email" id="email" name="email" required /></div>
		<div class="form-group"><label for="subject">{L.subject}</label><input type="text" id="subject" name="subject" /></div>
		<div class="form-group"><label for="message">{L.message} <span class="required">*</span></label><textarea id="message" name="message" rows="6" required></textarea></div>
		<div class="form-group"><button type="submit" class="general_button_type_3">{L.send}</button></div>
	</form>
</div>
